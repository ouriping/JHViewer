<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MarkdownContextViewer</RootNamespace>
    <!-- 可执行文件名保持不变，避免破坏预览处理程序与已有注册表查找。产品名见 Product。 -->
    <AssemblyName>MarkdownContextViewer</AssemblyName>
    <Product>JHViewer</Product>
    <AssemblyTitle>JHViewer</AssemblyTitle>
    <Version>0.1.1</Version>
    <Description>JHViewer：Windows 上的 Markdown / JSON / XML 查看器。</Description>
    <PackageTags>JHViewer;MarkdownViewer;MarkdownEditer;</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.37.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\docs\安装说明.txt">
      <Link>使用说明.txt</Link>
      <TargetPath>使用说明.txt</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="UI\OperationProgressForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="UI\OperationProgressForm.Designer.cs">
      <DependentUpon>OperationProgressForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="UI\OperationProgressForm.resx">
      <DependentUpon>OperationProgressForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="UI\PreviewRegistrationForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="UI\PreviewRegistrationForm.Designer.cs">
      <DependentUpon>PreviewRegistrationForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="UI\PreviewRegistrationForm.resx">
      <DependentUpon>PreviewRegistrationForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="UI\DocumentPreviewDemoForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="UI\DocumentPreviewDemoForm.Designer.cs">
      <DependentUpon>DocumentPreviewDemoForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="UI\DocumentPreviewDemoForm.resx">
      <DependentUpon>DocumentPreviewDemoForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="UI\WebMarkdownView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="UI\WebMarkdownView.Designer.cs">
      <DependentUpon>WebMarkdownView.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="UI\WebMarkdownView.resx">
      <DependentUpon>WebMarkdownView.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="UI\PublishCenterForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="UI\PublishCenterForm.Designer.cs">
      <DependentUpon>PublishCenterForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="UI\PublishCenterForm.resx">
      <DependentUpon>PublishCenterForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarkdownPreview.Shell\MarkdownPreview.Shell.csproj" />
    <ProjectReference Include="..\MarkdownPreview.Handler\MarkdownPreview.Handler.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\MarkdownPreview.Register\MarkdownPreview.Register.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\MarkdownWiki.Core\MarkdownWiki.Core.csproj" />
  </ItemGroup>

  <!-- 随程序分发 HTML Help Workshop 编译器 hhc.exe -->
  <ItemGroup>
    <None Include="..\..\tools\hhc\**\*.*" Link="tools\hhc\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\tools\hhc')" />
  </ItemGroup>

  <!-- 演示示例：复制到输出目录，便于「查看 → 打开 JSON/XML 演示」 -->
  <Target Name="CopyPreviewDemoSamples" AfterTargets="Build">
    <ItemGroup>
      <_PreviewDemoFiles Include="$(MSBuildProjectDirectory)\..\..\samples\preview-demo\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PreviewDemoFiles)"
          DestinationFolder="$(TargetDir)samples\preview-demo\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    预览组件是 net48，输出里带有 NuGet 版 System.Memory / System.Buffers 等门面程序集。
    不能复制到自包含发布目录的根上，否则会覆盖 .NET 8 运行时里的 System.Memory 8.0.0.0，
    WinForms 启动时会因找不到该版本而直接退出。
    因此统一放到 preview-handler 子目录，部署预览窗格时再从那里取。
  -->
  <Target Name="CopyPreviewHandlerOutputs" AfterTargets="Build">
    <PropertyGroup>
      <_HandlerOut>$(MSBuildProjectDirectory)\..\MarkdownPreview.Handler\bin\$(Configuration)\net48\</_HandlerOut>
      <_RegisterOut>$(MSBuildProjectDirectory)\..\MarkdownPreview.Register\bin\$(Configuration)\net48\</_RegisterOut>
    </PropertyGroup>
    <ItemGroup>
      <_HandlerFiles Include="$(_HandlerOut)**\*.*" Exclude="$(_HandlerOut)**\*.pdb" />
      <_RegisterFiles Include="$(_RegisterOut)MarkdownPreview.Register.exe" />
      <_RegisterFiles Include="$(_RegisterOut)MarkdownPreview.Register.exe.config" Condition="Exists('$(_RegisterOut)MarkdownPreview.Register.exe.config')" />
    </ItemGroup>
    <Copy SourceFiles="@(_HandlerFiles)" DestinationFolder="$(TargetDir)preview-handler\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_RegisterFiles)" DestinationFolder="$(TargetDir)preview-handler\" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPreviewHandlerToPublishDir" AfterTargets="Publish">
    <PropertyGroup>
      <_HandlerOut>$(MSBuildProjectDirectory)\..\MarkdownPreview.Handler\bin\$(Configuration)\net48\</_HandlerOut>
      <_RegisterOut>$(MSBuildProjectDirectory)\..\MarkdownPreview.Register\bin\$(Configuration)\net48\</_RegisterOut>
    </PropertyGroup>
    <ItemGroup>
      <_PublishHandlerFiles Include="$(_HandlerOut)**\*.*" Exclude="$(_HandlerOut)**\*.pdb" />
      <_PublishRegisterFiles Include="$(_RegisterOut)MarkdownPreview.Register.exe" />
      <_PublishRegisterFiles Include="$(_RegisterOut)MarkdownPreview.Register.exe.config" Condition="Exists('$(_RegisterOut)MarkdownPreview.Register.exe.config')" />
    </ItemGroup>
    <Copy SourceFiles="@(_PublishHandlerFiles)" DestinationFolder="$(PublishDir)preview-handler\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PublishRegisterFiles)" DestinationFolder="$(PublishDir)preview-handler\" SkipUnchangedFiles="true" />
  </Target>
</Project>
