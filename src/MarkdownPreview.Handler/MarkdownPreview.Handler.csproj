<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>MarkdownPreview.Handler</RootNamespace>
    <AssemblyName>MarkdownPreview.Handler</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>大白菜</Company>
    <Product>菁华 Markdown 浏览器</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="MarkdownPreviewControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="MarkdownPreviewControl.designer.cs">
      <DependentUpon>MarkdownPreviewControl.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="MarkdownPreviewControl.resx">
      <DependentUpon>MarkdownPreviewControl.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="PreviewHistoryForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="PreviewHistoryForm.Designer.cs">
      <DependentUpon>PreviewHistoryForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="PreviewHistoryForm.resx">
      <DependentUpon>PreviewHistoryForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpShell" Version="2.7.2" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
</Project>
