@page
@model MarkdownWiki.Pages.Admin.LoginModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "管理员登录";
}
<section class="content full login-page">
    <div class="login-card">
        <h1>管理员登录</h1>
        <p class="meta">进入编辑/管理主界面前，请先验证管理员密码。</p>
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert">@Model.ErrorMessage</div>
        }
        <form method="post" class="login-form">
            <input type="hidden" asp-for="ReturnUrl" />
            <label>
                管理员密码
                <input asp-for="Password" type="password" autocomplete="current-password" autofocus required />
            </label>
            <button type="submit">登录并进入管理后台</button>
        </form>
        <p class="meta"><a href="/">返回阅读站</a></p>
    </div>
</section>
