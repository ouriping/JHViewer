@page
@model MarkdownWiki.Pages.EditModel
@{
    ViewData["Title"] = ViewData["Title"] ?? "编辑";
}
<aside class="sidebar">
    <div class="sidebar-title">目录</div>
    <div id="wiki-tree" data-current="@Model.Path" data-mode="edit"></div>
</aside>
<section class="content editor-pane">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="ok">@Model.Message</div>
    }
    <form method="post" class="edit-form">
        <input type="hidden" asp-for="Path" />
        <div class="toolbar">
            <span class="path-label">@Model.Path</span>
            <button type="submit" asp-page-handler="Save">保存</button>
            <button type="submit" asp-page-handler="Preview" class="secondary">预览</button>
            <a class="button-link" href="/?path=@Uri.EscapeDataString(Model.Path ?? "")">返回阅读</a>
        </div>
        <textarea asp-for="Markdown" class="editor" spellcheck="false"></textarea>
    </form>
    @if (!string.IsNullOrEmpty(Model.PreviewHtml))
    {
        <details open class="preview-box">
            <summary>预览</summary>
            <article class="markdown-body">@Html.Raw(Model.PreviewHtml)</article>
        </details>
    }
</section>
