@using MarkdownWiki.Core.Models
@inject WikiOptions WikiOptions
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @WikiOptions.SiteTitle</title>
    <link rel="stylesheet" href="~/css/wiki.css" />
</head>
<body class="site-reader">
    <header class="topbar">
        <a class="brand" href="/">@WikiOptions.SiteTitle</a>
        <nav class="nav">
            <a href="/" class="@(IsActive("/Index") ? "active" : null)">阅读</a>
            <a href="/Search" class="@(IsActive("/Search") ? "active" : null)">搜索</a>
        </nav>
        <form class="search-box" action="/Search" method="get">
            <input type="search" name="q" placeholder="搜索文档…" value="@ViewData["Query"]" />
        </form>
        @if (WikiOptions.EnableEdit)
        {
            <a class="button-link admin-entry" href="/Admin">管理后台</a>
        }
    </header>
    <main class="shell">
        @RenderBody()
    </main>
    <script src="~/js/wiki-tree.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@functions {
    bool IsActive(string page) =>
        string.Equals(ViewContext.RouteData.Values["page"]?.ToString(), page, StringComparison.OrdinalIgnoreCase);
}
